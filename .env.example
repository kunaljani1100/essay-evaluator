# Anthropic API key (required for essay evaluation)
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the Claude model (defaults to claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: override the evaluate API URL for local development
# REACT_APP_EVALUATE_API_URL=/.netlify/functions/evaluate-essay
